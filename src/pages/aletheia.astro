---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Aletheia"
  description="Aletheia — a deduction mystery game spanning Greek history, in development. Devlog coming soon."
>
  <section class="hero">
    <p class="eyebrow">MAIN QUEST</p>
    <h1>Aletheia</h1>
    <span class="status-badge">Coming Soon</span>
    <p class="logline">
      A solo deduction mystery game rooted in Greek mythology and history, built
      in Godot 4. Details, devlog entries, and progress updates will land here
      as the project takes shape.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/chronicle">Follow the Devlog</a>
      <a
        class="btn btn-secondary"
        href="https://github.com/makrischaralampos"
        rel="noopener noreferrer"
        target="_blank"
      >
        GitHub
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: var(--space-12) 0 var(--space-8);
    max-width: 65ch;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    color: var(--color-accent);
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-4);
  }

  h1 {
    font-size: var(--font-size-2xl);
    color: var(--color-fg0);
    margin: 0 0 var(--space-4);
  }

  .status-badge {
    display: inline-block;
    font-size: var(--font-size-xs);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-gray), 20%, transparent);
    color: var(--color-gray);
    margin-bottom: var(--space-6);
  }

  .logline {
    color: var(--color-text);
    font-size: var(--font-size-lg);
    line-height: 1.6;
    margin: 0 0 var(--space-8);
  }

  .cta-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    font-size: var(--font-size-sm);
    text-decoration: none;
    border-radius: var(--radius);
    transition: transform var(--transition);
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg0);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
</style>
