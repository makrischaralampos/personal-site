---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";

const lastUpdated = "August 2026";
---

<Layout title="Now" description="What Chari is currently working on.">
  <PageHeader
    eyebrow="CURRENT QUEST LOG"
    title="Now"
    subtitle={`Last updated: ${lastUpdated}`}
  />

  <div class="prose">
    <p>
      A <a href="https://nownownow.com/about" rel="noopener">now page</a>, if
      you're not familiar — a snapshot of what I'm actually focused on right
      now, not a résumé of everything I've ever done.
    </p>

    <h2>Building</h2>
    <ul>
      <li>This site.</li>
      <li>
        A handful of one-day portfolio projects — self-hosted tools, small and
        shippable.
      </li>
    </ul>

    <h2>Designing</h2>
    <ul>
      <li>
        <strong>Aletheia</strong> — a deduction mystery game spanning 2,400 years
        of Greek history, in style of <em>The Case of the Golden Idol</em>.
      </li>
    </ul>

    <h2>Working</h2>
    <ul>
      <li>Full-stack dev on a maritime platform, day to day.</li>
    </ul>
  </div>
</Layout>
