---
interface Props {
  title: string;
  status: "Completed" | "In Progress" | "Planned";
  summary: string;
  stack: string[];
  githubUrl?: string;
  liveUrl?: string;
}

const { title, status, summary, stack, githubUrl, liveUrl } = Astro.props;

const statusClass = {
  Completed: "status-completed",
  "In Progress": "status-in-progress",
  Planned: "status-planned",
}[status];
---

<article class="quest-card">
  <div class="quest-card-header">
    <h3>{title}</h3>
    <span class={`status-badge ${statusClass}`}>{status}</span>
  </div>
  <p class="summary">{summary}</p>
  <ul class="stack-list" aria-label="Tech stack">
    {stack.map((tech) => <li>{tech}</li>)}
  </ul>
  <div class="quest-links">
    {
      githubUrl && (
        <a href={githubUrl} rel="noopener noreferrer" target="_blank">
          Source →
        </a>
      )
    }
    {
      liveUrl && (
        <a href={liveUrl} rel="noopener noreferrer" target="_blank">
          Live →
        </a>
      )
    }
  </div>
</article>

<style>
  .quest-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .quest-card-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: var(--space-3);
  }

  h3 {
    font-size: var(--font-size-sm);
    font-family: var(--font-display);
    color: var(--color-fg0);
    margin: 0;
  }

  .status-badge {
    font-size: var(--font-size-xs);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius);
    white-space: nowrap;
  }

  .status-completed {
    background: color-mix(in srgb, var(--color-green), 20%, transparent);
    color: var(--color-green);
  }

  .status-in-progress {
    background: color-mix(in srgb, var(--color-yellow), 20%, transparent);
    color: var(--color-yellow);
  }

  .status-planned {
    background: color-mix(in srgb, var(--color-gray), 20%, transparent);
    color: var(--color-gray);
  }

  .summary {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin: 0;
    flex-grow: 1;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--font-size-xs);
  }

  .stack-list li {
    background: var(--color-bg2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius);
    color: var(--color-fg2);
  }

  .quest-links {
    display: flex;
    gap: var(--space-4);
    font-size: var(--font-size-sm);
  }
</style>
