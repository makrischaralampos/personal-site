---
import SoundToggle from "./playful/SoundToggle.astro";

const navItems = [
    { href: "/", label: "Character Sheet" },
    { href: "/about", label: "Origin Story" },
    { href: "/quests", label: "Quest Board" },
    { href: "/aletheia", label: "Main Quest" },
    { href: "/chronicle", label: "Chronicle" },
    { href: "/loadout", label: "Loadout" },
    { href: "/now", label: "Now" },
    { href: "/contact", label: "Contact" },
];
---

<header class="site-header">
    <a href="/" class="site-title">Chari</a>
    <nav aria-label="Main navigation">
        <ul>
            {
                navItems.map((item) => (
                    <li>
                        <a href={item.href}>{item.label}</a>
                    </li>
                ))
            }
        </ul>
    </nav>
    <SoundToggle />
</header>

<style>
    .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--space-4);
        padding: var(--space-4) var(--space-6);
        border-bottom: 1px solid var(--color-border);
        position: relative;
        z-index: 10;
    }

    .site-title {
        font-family: var(--font-display);
        font-size: var(--font-size-sm);
        color: var(--color-fg0);
        text-decoration: none;
    }

    nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    nav a {
        font-size: var(--font-size-sm);
        text-decoration: none;
        color: var(--color-text-muted);
        transition: color var(--transition);
    }

    nav a:hover {
        color: var(--color-accent);
    }
</style>
